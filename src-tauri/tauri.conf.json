{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisper",
  "version": "1.0.8",
  "identifier": "com.hudsonbrendon.openwispr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wisper",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "index.html",
        "width": 360,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Wisper Dev",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hudsonbrendon/openwispr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRThBMDU1QkRCQzYwNTIKUldSU1lMeTlWYURvV3BBWENCamg1ZTJ4SHYwcFpSYzJyM1d3Um44dUoyUEVwSUx3NXhFelFmWkcK"
    }
  }
}
