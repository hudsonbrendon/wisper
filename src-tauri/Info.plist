<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS shows this string when prompting for microphone access. Without
         the key, the OS silently denies capture and recordings are empty. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Wisper uses the microphone to transcribe your speech on-device. Audio never leaves your computer.</string>
    <!-- ScreenCaptureKit (macOS 13.0–14.3) gates system-audio capture behind the
         Screen Recording permission; this string is shown when prompting. No
         video is recorded — only the meeting's output audio. -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>Wisper captures the audio from your meetings so it can transcribe what other participants say. No video is recorded.</string>
    <!-- Audio-input usage description for the system-audio capture path. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Wisper captures meeting audio so it can transcribe what other participants say.</string>
</dict>
</plist>
